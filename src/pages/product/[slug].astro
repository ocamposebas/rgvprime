---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SingleProductPage from "../../components/app/SingleProductPage.jsx";
import {
  buildProductOffers,
  getPermanentProductRedirect,
  getProductSeo,
  SITE_URL,
} from "../../lib/seo";

const { slug } = Astro.params;
const routeSlug = String(slug || "").trim();

const redirectTarget = getPermanentProductRedirect(routeSlug);

if (redirectTarget) {
  return Astro.redirect(redirectTarget, 301);
}

let product = null;
let productFetchStatus = 503;

try {
  const productResponse = await fetch(
    new URL(`/api/products?slug=${encodeURIComponent(routeSlug)}`, Astro.url.origin),
    {
      headers: {
        Accept: "application/json",
        "Cache-Control": "no-cache",
      },
    },
  );

  productFetchStatus = productResponse.status;

  if (productResponse.ok) {
    const payload = await productResponse.json();
    product = payload?.product || payload?.products?.[0] || null;
    productFetchStatus = product ? 200 : 404;
  }
} catch {
  product = null;
  productFetchStatus = 503;
}

const isUnavailable = !product;

if (isUnavailable) {
  Astro.response.status = productFetchStatus === 404 ? 404 : 503;
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow, noarchive");
}

const productName = product?.name || product?.title || "Product Not Found";
const productSeo = product
  ? getProductSeo(product)
  : {
      title: "Product Not Found",
      description: "The requested product page is not available.",
      imageAlt: "RGVPRIME LLC logo",
    };
const productImage =
  product?.image || product?.images?.[0]?.src || "/logo.webp";
const productImageAlt = productSeo.imageAlt;
const canonicalValue = `/product/${product?.slug || routeSlug}`;
const canonicalUrl = new URL(canonicalValue, SITE_URL).toString();
const offers = product ? buildProductOffers(product, canonicalUrl) : null;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: productName,
  description: productSeo.description,
  url: canonicalUrl,
  image: [new URL(productImage, SITE_URL).toString()],
  ...(product?.sku ? { sku: String(product.sku) } : {}),
  ...(offers ? { offers } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${SITE_URL}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Shop",
      item: `${SITE_URL}/shop`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: productName,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={productSeo.title}
  description={productSeo.description}
  image={productImage}
  imageAlt={productImageAlt}
  canonical={isUnavailable ? undefined : canonicalValue}
  noindex={isUnavailable}
  errorPage={isUnavailable}
  ogType="product"
>
  {
    product && (
      <>
        <script
          slot="head"
          type="application/ld+json"
          set:html={JSON.stringify(productSchema)}
        />
        <script
          slot="head"
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      </>
    )
  }

  <SingleProductPage slug={routeSlug} client:load />
</BaseLayout>
