---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SingleProductPage from "../../components/app/SingleProductPage.jsx";
import {
  getInitialProductConfiguration,
  getPriceOffer,
  getProductImage,
} from "../../components/app/ProductDetails.jsx";
import {
  buildProductOffer,
  getPermanentProductRedirect,
  getProductSeo,
  getPublicProductSlug,
  SITE_URL,
  toPlainText,
} from "../../lib/seo";
import { getServerProductsResponse } from "../api/products.js";

const { slug } = Astro.params;
const routeSlug = String(slug || "").trim();

const redirectTarget = getPermanentProductRedirect(routeSlug);

if (redirectTarget) {
  return Astro.redirect(redirectTarget, 301);
}

let product = null;
let productFetchStatus = 503;

try {
  const productResponse = await getServerProductsResponse(
    new Request(
      new URL(
        `/api/products?slug=${encodeURIComponent(routeSlug)}`,
        Astro.url.origin,
      ),
      {
        headers: {
          Accept: "application/json",
        },
      },
    ),
  );

  productFetchStatus = productResponse.status;

  if (productResponse.ok) {
    const payload = await productResponse.json();
    product = payload?.product || payload?.products?.[0] || null;
    productFetchStatus = product ? 200 : 404;
  }
} catch {
  product = null;
  productFetchStatus = 503;
}

const isUnavailable = !product;

if (isUnavailable) {
  Astro.response.status = productFetchStatus === 404 ? 404 : 503;
  Astro.response.headers.set("X-Robots-Tag", "noindex, follow, noarchive");
}

const productName = toPlainText(product?.name || product?.title || "Product Not Found");
const productSeo = product
  ? getProductSeo(product)
  : {
      title: "Product Not Found",
      description: "The requested product page is not available.",
      imageAlt: "RGVPRIME LLC logo",
    };
const productImage = getProductImage(product);
const productImageAlt = productSeo.imageAlt;
const canonicalValue = `/product/${getPublicProductSlug(product?.slug || routeSlug)}`;
const canonicalUrl = new URL(canonicalValue, SITE_URL).toString();
const initialConfiguration = getInitialProductConfiguration(product);
const offer = initialConfiguration && buildProductOffer(
  initialConfiguration,
  getPriceOffer(initialConfiguration),
  canonicalUrl,
);
const productCategory = product?.categories?.find(
  (category) => category.slug !== "uncategorized",
)?.name;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${canonicalUrl}#product`,
  name: productName,
  ...(productSeo.productSummary ? { description: productSeo.productSummary } : {}),
  url: canonicalUrl,
  image: [new URL(getProductImage(initialConfiguration || product), SITE_URL).toString()],
  ...(product?.sku ? { sku: String(product.sku) } : {}),
  ...(productCategory ? { category: productCategory } : {}),
  brand: {
    "@type": "Brand",
    name: "RGVPRIME",
  },
  itemCondition: "https://schema.org/NewCondition",
  ...(productSeo.researchUse ? {
    audience: {
      "@type": "PeopleAudience",
      audienceType: "Qualified laboratory and in-vitro researchers",
    },
  } : {}),
  ...(offer ? { offers: offer } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${SITE_URL}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Shop",
      item: `${SITE_URL}/shop`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: productName,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={productSeo.title}
  description={productSeo.description}
  image={productImage}
  imageAlt={productImageAlt}
  canonical={isUnavailable ? undefined : canonicalValue}
  noindex={isUnavailable}
  errorPage={isUnavailable}
  ogType="product"
>
  {
    product && (
      <>
        <script
          slot="head"
          type="application/ld+json"
          set:html={JSON.stringify(productSchema).replace(/</g, "\\u003c")}
        />
        <script
          slot="head"
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema).replace(/</g, "\\u003c")}
        />
      </>
    )
  }

  <SingleProductPage slug={routeSlug} initialProduct={product} client:load />
</BaseLayout>
