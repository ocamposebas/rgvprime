---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SingleProductPage from "../../components/app/SingleProductPage.jsx";

const { slug } = Astro.params;
const routeSlug = String(slug || "").trim();

const permanentProductRedirects = new Map([
  ["cagrilintide-5mg", "/product/rg-cag"],
  ["tesamorelin-10mg", "/product/rg-tesa"],
  ["fat-blaster-10ml", "/product/lemon-bottle-10ml"],
  ["hospira-bac-30ml", "/product/hosp-recon-water"],
  ["bac-water", "/product/recon-water"],
  ["pl-rt", "/product/rg-rt"],
  ["rgv-tesa", "/product/rg-tesa"],
]);

const redirectTarget = permanentProductRedirects.get(routeSlug.toLowerCase());

if (redirectTarget) {
  return Astro.redirect(redirectTarget, 301);
}

function toPlainText(value = "") {
  return String(value)
    .replace(/<style[\s\S]*?<\/style>/gi, " ")
    .replace(/<script[\s\S]*?<\/script>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&quot;/gi, '"')
    .replace(/&#0?39;|&apos;/gi, "'")
    .replace(/\s+/g, " ")
    .trim();
}

let product = null;
let productFetchStatus = 503;

try {
  const productResponse = await fetch(
    new URL(`/api/products?slug=${encodeURIComponent(routeSlug)}`, Astro.url.origin),
    {
      headers: {
        Accept: "application/json",
        "Cache-Control": "no-cache",
      },
    },
  );

  productFetchStatus = productResponse.status;

  if (productResponse.ok) {
    const payload = await productResponse.json();
    product = payload?.product || payload?.products?.[0] || null;
    productFetchStatus = product ? 200 : 404;
  }
} catch {
  product = null;
  productFetchStatus = 503;
}

const isUnavailable = !product;

if (isUnavailable) {
  Astro.response.status = productFetchStatus === 404 ? 404 : 503;
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
}

const fallbackName = routeSlug.replace(/-/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
const productName = product?.name || product?.title || fallbackName || "Research Product";
const rawDescription = product?.short_description || product?.description || "";
const productDescription =
  toPlainText(rawDescription).slice(0, 160) ||
  "Research-use-only laboratory product from RGVPRIME LLC.";
const productImage =
  product?.image || product?.images?.[0]?.src || "/logo.webp";
const productImageAlt =
  product?.image_alt || product?.images?.[0]?.alt || productName;
const canonicalValue = `/product/${product?.slug || routeSlug}`;
const canonicalUrl = new URL(canonicalValue, "https://rgvprimellc.com").toString();
const numericPrice = Number(product?.price ?? product?.sale_price ?? product?.regular_price);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: productName,
  description: productDescription,
  url: canonicalUrl,
  image: [new URL(productImage, "https://rgvprimellc.com").toString()],
  ...(product?.sku ? { sku: String(product.sku) } : {}),
  ...(Number.isFinite(numericPrice) && numericPrice > 0
    ? {
        offers: {
          "@type": "Offer",
          url: canonicalUrl,
          priceCurrency: "USD",
          price: numericPrice.toFixed(2),
          availability:
            product?.stock_status === "instock"
              ? "https://schema.org/InStock"
              : "https://schema.org/OutOfStock",
        },
      }
    : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://rgvprimellc.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Shop",
      item: "https://rgvprimellc.com/shop",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: productName,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={productName}
  description={productDescription}
  image={productImage}
  imageAlt={productImageAlt}
  canonical={canonicalValue}
  noindex={isUnavailable}
>
  {
    product && (
      <>
        <script
          slot="head"
          type="application/ld+json"
          set:html={JSON.stringify(productSchema)}
        />
        <script
          slot="head"
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      </>
    )
  }

  <SingleProductPage slug={routeSlug} client:load />
</BaseLayout>
