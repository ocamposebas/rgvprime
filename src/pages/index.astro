---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/app/HomePage.jsx";

let featuredProducts = [];

try {
  const response = await fetch(new URL("/api/featured-products", Astro.url.origin), {
    headers: {
      Accept: "application/json",
    },
    // Never let a cold WooCommerce request delay the homepage. The client-side
    // featured section retries in the background when this fast path times out.
    signal: AbortSignal.timeout(1400),
  });

  if (response.ok) {
    const data = await response.json();
    featuredProducts = Array.isArray(data.products) ? data.products : [];
  }
} catch {
  featuredProducts = [];
}
---

<BaseLayout
  title="RGVPRIME LLC | Peps & Performance"
  description="Premium research-use-only products from RGVPRIME LLC."
  image="/og-image.jpg"
>
  <HomePage client:load featuredProducts={featuredProducts} />
</BaseLayout>
