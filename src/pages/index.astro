---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/app/HomePage.jsx";
---

<BaseLayout
  bodyClass="rgv-home-page"
  title="Research Peptides and Laboratory Products | RGVPRIME LLC"
  description="Explore RGVPRIME research peptides and laboratory products with current availability, clear configurations, secure ordering, and Certificate of Analysis access."
>
  <Fragment slot="head">
    <meta name="onboarding-verification" content="intake-verify-3fec5d0be6438034a769" />
    <link rel="preload" href="/fonts/goldman/Goldman-Bold.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/sora/Sora-Variable.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
  </Fragment>
  <HomePage client:load />
</BaseLayout>
