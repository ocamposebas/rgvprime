---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "November 4, 2026";

const quickLinks = [
  { label: "Research Use", href: "#research-use" },
  { label: "Terms", href: "#terms" },
  { label: "Shipping", href: "#shipping" },
  { label: "Refunds", href: "#refunds" },
  { label: "Privacy", href: "#privacy" },
  { label: "Cookies", href: "#cookies" },
  { label: "Claims", href: "#claims" },
  { label: "Accessibility", href: "#accessibility" },
];

const legalSections = [
  {
    id: "research-use",
    eyebrow: "Research Use Disclaimer",
    title: "Research Use Only Notice",
    intro:
      "All products offered, displayed, referenced, or sold by RGVPRIME LLC are provided exclusively for qualified laboratory, analytical, and in-vitro research purposes.",
    clauses: [
      {
        title: "Restricted Purpose",
        body:
          "Products are strictly intended for research use only. They are not intended, labeled, promoted, represented, or sold for human consumption, veterinary use, diagnostic use, therapeutic use, cosmetic use, food use, dietary supplement use, clinical use, household use, or any form of personal application.",
      },
      {
        title: "Acknowledgment by Website Use",
        body:
          "By accessing this website, browsing any page, creating an account, submitting information, placing an order, or otherwise continuing to use this website, you expressly acknowledge and agree that you understand the research-use-only nature of all products offered by RGVPRIME LLC.",
      },
      {
        title: "Qualified Handling Required",
        body:
          "Customer represents and warrants that any products purchased will be received, stored, handled, documented, used, and disposed of only by qualified individuals or entities familiar with applicable laboratory standards, safety protocols, institutional requirements, and regulatory obligations.",
      },
      {
        title: "No Medical or Scientific Advice",
        body:
          "No content on this website, including product names, product descriptions, images, labels, certificates, documentation, marketing copy, email communication, or customer support communication, shall be interpreted as medical advice, dosage guidance, treatment guidance, diagnostic guidance, health advice, or a recommendation for any non-research use.",
      },
      {
        title: "Regulatory Statement",
        body:
          "Statements appearing on this website have not been evaluated by the U.S. Food and Drug Administration. Products are not intended to diagnose, treat, cure, mitigate, or prevent any disease, condition, disorder, or health-related issue.",
      },
    ],
  },
  {
    id: "terms",
    eyebrow: "Terms & Conditions",
    title: "Website Terms and Conditions",
    intro:
      "These Terms and Conditions govern access to, use of, and transactions made through the RGVPRIME LLC website.",
    clauses: [
      {
        title: "Binding Agreement",
        body:
          "By accessing, browsing, registering, purchasing, or otherwise using this website, you agree to be legally bound by these Terms and Conditions, all posted policies, disclaimers, notices, and any additional terms presented at checkout or through website functionality.",
      },
      {
        title: "Customer Responsibility",
        body:
          "Customer is solely responsible for determining whether the purchase, importation, possession, handling, storage, use, and disposal of any product complies with all applicable federal, state, local, institutional, laboratory, and professional requirements.",
      },
      {
        title: "Order Review and Refusal",
        body:
          "RGVPRIME LLC reserves the right, in its sole discretion, to review, hold, cancel, refuse, limit, or decline any order for any reason, including but not limited to suspected misuse, inaccurate information, payment concerns, compliance concerns, inventory discrepancies, pricing errors, fraud prevention, or indications inconsistent with research-use-only requirements.",
      },
      {
        title: "Website Accuracy",
        body:
          "Product descriptions, availability, pricing, specifications, images, documentation, and website content are provided for general informational purposes and may be updated, corrected, restricted, or removed at any time without prior notice.",
      },
      {
        title: "Prohibited Use",
        body:
          "Customer shall not use this website, its content, or any product purchased from RGVPRIME LLC for any unlawful, unsafe, misleading, medical, diagnostic, therapeutic, veterinary, dietary, cosmetic, recreational, personal, or non-research purpose.",
      },
      {
        title: "Limitation of Liability",
        body:
          "To the fullest extent permitted by applicable law, RGVPRIME LLC shall not be liable for any direct, indirect, incidental, consequential, special, punitive, or exemplary damages arising from misuse, mishandling, improper storage, unauthorized use, unlawful use, carrier delays, customer error, or any conduct occurring after products leave the control of RGVPRIME LLC.",
      },
    ],
  },
  {
    id: "shipping",
    eyebrow: "Shipping Policy",
    title: "Shipping, Fulfillment and Delivery",
    intro:
      "This Shipping Policy applies to all orders placed through the RGVPRIME LLC website.",
    clauses: [
      {
        title: "Processing",
        body:
          "Orders are processed only after payment confirmation and internal review. Processing times may vary based on order volume, verification requirements, product availability, operational limitations, holidays, weather conditions, carrier service interruptions, or other circumstances affecting fulfillment.",
      },
      {
        title: "Carrier Control",
        body:
          "Once a shipment is accepted by the carrier, delivery timing, tracking scans, routing, transit conditions, delivery attempts, and final delivery are controlled by the carrier. RGVPRIME LLC is not responsible for delays, missed scans, routing changes, weather disruptions, carrier handling, delivery exceptions, or carrier-related service failures after acceptance by the carrier.",
      },
      {
        title: "Address Accuracy",
        body:
          "Customer is solely responsible for providing a complete, accurate, and deliverable shipping address at checkout. RGVPRIME LLC is not responsible for failed delivery, returned shipments, delays, lost packages, or additional costs resulting from incorrect, incomplete, undeliverable, or restricted address information provided by the customer.",
      },
      {
        title: "Shipping Charges",
        body:
          "Shipping charges are non-refundable once an order has been packed, transferred, tendered to, or accepted by the carrier, except where otherwise required by applicable law or where RGVPRIME LLC is unable to fulfill the order.",
      },
      {
        title: "Returned or Refused Shipments",
        body:
          "If a shipment is returned due to customer error, refusal, failed delivery attempts, incorrect address information, restricted access, or similar delivery-related circumstances, additional shipping charges, handling charges, or review requirements may apply before any reshipment is approved.",
      },
      {
        title: "Tracking Information",
        body:
          "Tracking numbers and carrier updates are provided for convenience. Tracking information may not update immediately and may experience delays. Lack of immediate tracking movement does not necessarily indicate that an order has not shipped.",
      },
    ],
  },
  {
    id: "refunds",
    eyebrow: "Refund Policy",
    title: "Refunds, Returns and Cancellations",
    intro:
      "Due to the nature of research-use-only products and the importance of chain-of-custody integrity, all refund, return, cancellation, and replacement requests are subject to strict review.",
    clauses: [
      {
        title: "Final Sale Policy",
        body:
          "All sales are considered final once an order has been processed, packed, transferred, tendered to, or shipped. RGVPRIME LLC does not accept returns or exchanges for buyer’s remorse, change of mind, improper ordering, lack of qualification, customer misunderstanding, failure to read product information, or any non-defective customer-related reason.",
      },
      {
        title: "No Restocking After Shipment",
        body:
          "For quality control, safety, documentation, and chain-of-custody reasons, products that have left the control of RGVPRIME LLC cannot be returned, restocked, resold, or exchanged.",
      },
      {
        title: "Cancellation Requests",
        body:
          "Cancellation requests must be submitted as soon as possible after order placement. Submission of a cancellation request does not guarantee cancellation. If an order has already been processed, packed, transferred, or shipped, it may no longer be eligible for cancellation.",
      },
      {
        title: "Shipping Fees",
        body:
          "Shipping fees are not refundable once the package has been packed, transferred, tendered to, or accepted by the carrier, except where required by applicable law or where RGVPRIME LLC is unable to fulfill the order.",
      },
      {
        title: "Approved Remedies",
        body:
          "Where a claim is approved after review, RGVPRIME LLC may, in its sole discretion, provide a replacement, store credit, partial refund, full refund, or other commercially reasonable resolution depending on the facts and documentation available.",
      },
      {
        title: "Denied Claims",
        body:
          "RGVPRIME LLC reserves the right to deny any claim that is incomplete, unsupported, inconsistent with order records, submitted outside the required timeframe, fraudulent, abusive, carrier-related, caused by customer error, or otherwise ineligible under these policies.",
      },
    ],
  },
  {
    id: "privacy",
    eyebrow: "Privacy Policy",
    title: "Privacy and Data Practices",
    intro:
      "This Privacy Policy explains what personal information RGVPRIME LLC collects, why it is used, when it may be shared, and the choices available to visitors and customers.",
    clauses: [
      {
        title: "Information We Collect",
        body:
          "Depending on how a person uses the site, RGVPRIME LLC may collect identifiers and contact details; account and authentication details; billing and shipping details; order and support history; communications and marketing preferences; device, browser, IP address and security-event information; and website or cart activity collected only when the applicable optional technology has been permitted.",
      },
      {
        title: "Sources of Information",
        body:
          "Information is collected directly from customers when they browse, create an account, sign in, place an order, contact support or subscribe; automatically from necessary website and security systems; and from service providers involved in authentication, payments, fraud prevention, fulfillment, delivery and customer communications.",
      },
      {
        title: "Why We Use Information",
        body:
          "Information is used to provide accounts, carts, checkout, orders, shipping and support; authenticate users and prevent fraud or abuse; maintain records and comply with legal obligations; improve site reliability; and send optional marketing or cart-recovery communications where the customer has provided the required consent. Depending on location, these activities rely on performing a requested transaction, legitimate operational and security interests, legal obligations, or consent.",
      },
      {
        title: "Payments and Service Providers",
        body:
          "RGVPRIME LLC discloses only the information reasonably needed by providers supporting hosting, WordPress and WooCommerce commerce functions, authentication, security checks, payment processing, fulfillment, shipping, email delivery and support. Payment providers process payment credentials under their own notices; RGVPRIME LLC receives transaction status and identifiers needed to complete and document the order. Providers may use information only as permitted by their agreements and applicable law.",
      },
      {
        title: "Marketing, Sale and Targeted Advertising",
        body:
          "RGVPRIME LLC does not sell personal information for money and does not knowingly use personal information for cross-context behavioral advertising. Omnisend marketing and cart-recovery technology remains off until optional cookie consent is given, and marketing messages are subject to the choices presented at signup and in each eligible message. A recognized Global Privacy Control signal keeps optional marketing technology off.",
      },
      {
        title: "Retention and Security",
        body:
          "Information is retained only as long as reasonably needed for the purposes described, including providing an account or order, resolving disputes, preventing fraud, maintaining required tax and transaction records, and enforcing agreements. RGVPRIME LLC uses administrative, technical and organizational safeguards designed to protect information, but no online system can be guaranteed completely secure.",
      },
      {
        title: "Your Privacy Rights",
        body:
          "Depending on applicable law, a person may request access to, correction of, deletion of, or a portable copy of personal information and may opt out of qualifying sale, targeted advertising or profiling. RGVPRIME LLC will not discriminate for exercising an applicable privacy right. Requests may be submitted through the official contact page; identity and authority may be verified, and an appeal may be requested where local law provides one.",
      },
      {
        title: "Children and Age Restrictions",
        body:
          "The website and its products are intended for adults age 21 or older and are not directed to children. RGVPRIME LLC does not knowingly collect personal information from a child under 13. A parent or guardian who believes a child has provided information should contact RGVPRIME LLC so the request can be reviewed and the information deleted where required.",
      },
      {
        title: "Changes and Contact",
        body:
          "This policy may be updated to reflect changes in practices, technology or legal requirements. The updated date above identifies the current version. Questions, privacy requests and complaints may be submitted through the official contact page or the support information displayed in the website footer.",
      },
    ],
  },
  {
    id: "cookies",
    eyebrow: "Cookie Policy",
    title: "Cookies and Similar Technologies",
    intro:
      "This Cookie Policy describes the browser cookies, local storage and similar technology used by RGVPRIME LLC and explains how a visitor can control optional uses.",
    clauses: [
      {
        title: "What These Technologies Do",
        body:
          "Cookies are small records stored by a browser. Local and session storage serve similar purposes. They can keep a secure session active, preserve a cart, remember a privacy choice, protect forms, complete a requested sign-in or payment, and—only with permission—support marketing measurement and cart recovery.",
      },
      {
        title: "Strictly Necessary Technology",
        body:
          "Necessary technology supports account and compliance sessions, age-gate status, fraud prevention, security challenges, cart state, checkout and the saved cookie choice. Core session and gate cookies generally last up to 30 days; the cookie preference lasts up to 180 days; cart and checkout storage remains until checkout, manual clearing, expiration imposed by the application, or browser-storage deletion. These functions cannot be disabled through the banner because the requested service would not work correctly without them.",
      },
      {
        title: "Authentication, Security and Payment Providers",
        body:
          "When a visitor requests Google sign-in, completes a security challenge, selects a payment method or uses another embedded service necessary to complete an action, that provider may set its own cookies or receive technical data under its privacy notice. RGVPRIME LLC activates these services only as needed for the feature the visitor requests, security or transaction processing.",
      },
      {
        title: "Optional Marketing and Cart Recovery",
        body:
          "If a visitor accepts optional marketing technology, Omnisend may process page-view and cart activity, a contact identifier after email entry, and checkout activity to measure engagement and support cart-recovery communications. This script and its related tracking remain blocked before consent and when consent is rejected or withdrawn.",
      },
      {
        title: "Analytics",
        body:
          "RGVPRIME LLC does not currently activate a separate standalone analytics category. Optional marketing technology may produce engagement measurements when marketing consent is enabled. If the site's technology or purposes materially change, this policy and the preference controls will be updated before the new optional use is enabled.",
      },
      {
        title: "Your Choices",
        body:
          "A visitor may accept all optional technology, reject non-essential technology, or manage the marketing category. The Privacy Choices control in the footer can be used at any time to change or withdraw consent. Browser settings may also delete or block storage, although blocking necessary storage can prevent account, cart or checkout features from working.",
      },
      {
        title: "Global Privacy Control",
        body:
          "When the browser sends a recognized Global Privacy Control signal, RGVPRIME LLC treats it as a direction to keep optional marketing technology off for that browser. The preference center displays the signal and prevents marketing consent from being enabled while it remains active.",
      },
      {
        title: "Updates and Questions",
        body:
          "Cookie practices may change as the site and its providers evolve. Material changes will be reflected in this policy and, where appropriate, a new consent decision will be requested. Questions may be submitted through the official contact page.",
      },
    ],
  },
  {
    id: "claims",
    eyebrow: "Claims Procedure",
    title: "Damaged, Incorrect or Incomplete Orders",
    intro:
      "Any issue involving a damaged, incorrect, missing, or incomplete order must be reported promptly and supported by sufficient documentation.",
    clauses: [
      {
        title: "Reporting Window",
        body:
          "Claims involving damaged, incorrect, missing, or incomplete items must be submitted within forty-eight (48) hours of carrier-confirmed delivery. Claims submitted after this period may be denied.",
      },
      {
        title: "Required Documentation",
        body:
          "Customer must provide the order number, clear photographs of the outer package, shipping label, internal packaging, product label, product condition, and any visible damage or discrepancy. RGVPRIME LLC may request additional information before reviewing or approving any claim.",
      },
      {
        title: "Carrier Issues",
        body:
          "Claims involving carrier delay, delivery scan issues, package theft, misdelivery, weather delay, or delivery exception may require carrier investigation. RGVPRIME LLC does not guarantee reimbursement, replacement, or credit for carrier-related issues outside its control.",
      },
      {
        title: "Fraud Prevention",
        body:
          "RGVPRIME LLC reserves the right to deny, limit, or investigate claims that appear fraudulent, repetitive, abusive, altered, unsupported, or inconsistent with fulfillment, shipping, payment, or carrier records.",
      },
    ],
  },
  {
    id: "accessibility",
    eyebrow: "Accessibility Statement",
    title: "Access for All Visitors",
    intro:
      "RGVPRIME LLC is committed to improving the usability and accessibility of its website for people with disabilities.",
    clauses: [
      {
        title: "Ongoing Effort",
        body:
          "RGVPRIME LLC works to support keyboard access, readable contrast, meaningful labels, responsive layouts and compatibility with commonly used assistive technology. Accessibility is an ongoing process, and portions of the site or third-party services may not yet provide an ideal experience in every configuration.",
      },
      {
        title: "Assistance and Alternative Access",
        body:
          "If a visitor cannot access information, complete a form or use a feature, RGVPRIME LLC will make reasonable efforts to provide the information or service through an alternative method. Contact details and text support are available in the website footer.",
      },
      {
        title: "Report a Problem",
        body:
          "Accessibility feedback may be submitted through the official contact page. Including the page address, a description of the problem, device and browser information, and any assistive technology used will help the team investigate and respond more effectively.",
      },
    ],
  },
];
---

<BaseLayout
  title="Policies | RGVPRIME LLC"
  description="Review the official RGVPRIME LLC policies covering research use, terms, shipping, refunds, claims, privacy, cookies, data choices, and accessibility."
>
  <main class="relative min-h-screen overflow-hidden bg-[#030303] text-white">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_8%,rgba(220,38,38,0.16),transparent_28%),radial-gradient(circle_at_86%_18%,rgba(127,29,29,0.12),transparent_34%),linear-gradient(180deg,rgba(255,255,255,0.04),transparent_24%)]"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-red-500/40 to-transparent"></div>

    <section class="relative z-10 mx-auto max-w-[1200px] px-6 pb-24 pt-28 sm:px-8 lg:px-12 lg:pt-32">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <button
          type="button"
          data-back-button
          class="group inline-flex w-fit items-center gap-3 rounded-full border border-white/10 bg-white/[0.035] px-4 py-2.5 text-xs font-black uppercase tracking-[0.14em] text-white/55 transition hover:border-red-500/35 hover:bg-red-500/[0.08] hover:text-white"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-full border border-white/10 bg-black/30 text-white/70 transition group-hover:border-red-500/35 group-hover:text-red-300">
            ←
          </span>
          Back
        </button>

        <nav
          class="flex flex-wrap items-center gap-2 text-[11px] font-black uppercase tracking-[0.16em] text-white/35"
          aria-label="Breadcrumb"
        >
          <a href="/" class="transition hover:text-white">Home</a>
          <span class="text-white/18">/</span>
          <span class="text-red-300">Policies</span>
        </nav>
      </div>

      <div class="grid gap-10 lg:grid-cols-[1fr_0.72fr] lg:items-end">
        <div class="max-w-3xl">
          <p class="text-xs font-black uppercase tracking-[0.32em] text-red-400">
            RGVPRIME LLC
          </p>

          <h1 class="mt-5 text-4xl font-black tracking-[-0.04em] text-white sm:text-5xl lg:text-6xl">
            Policies & Legal Information
          </h1>

          <p class="mt-6 text-sm leading-7 text-white/60 sm:text-base sm:leading-8">
            Please review these policies carefully before accessing this
            website, creating an account, submitting information, or placing an
            order. Continued use of this website constitutes acknowledgment and
            acceptance of the terms, notices, limitations, and disclaimers set
            forth below.
          </p>

          <p class="mt-5 text-xs font-semibold uppercase tracking-[0.16em] text-white/35">
            Last updated: {lastUpdated}
          </p>
        </div>

        <aside class="rounded-[2rem] border border-red-500/20 bg-red-500/[0.055] p-6 shadow-[0_24px_90px_rgba(0,0,0,0.35)]">
          <p class="text-xs font-black uppercase tracking-[0.22em] text-red-300">
            Formal Notice
          </p>

          <p class="mt-4 text-sm leading-7 text-white/62">
            All products are offered exclusively for qualified laboratory and
            in-vitro research purposes. No product is offered, intended, or
            permitted for human consumption or any non-research application.
          </p>
        </aside>
      </div>

      <nav
        class="mt-12 flex flex-wrap gap-3 border-y border-white/10 py-5"
        aria-label="Policy navigation"
      >
        {quickLinks.map((item) => (
          <a
            href={item.href}
            class="rounded-full border border-white/10 bg-white/[0.035] px-4 py-2 text-xs font-black uppercase tracking-[0.12em] text-white/52 transition hover:border-red-500/45 hover:bg-red-500/[0.08] hover:text-white"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <section class="mt-12 rounded-[2.25rem] border border-white/10 bg-white/[0.035] p-6 shadow-[0_26px_90px_rgba(0,0,0,0.28)] sm:p-8 lg:p-10">
        <div class="grid gap-8 lg:grid-cols-[0.4fr_1fr]">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.22em] text-red-400">
              Governing Notice
            </p>

            <h2 class="mt-3 text-2xl font-black tracking-tight text-white">
              Acceptance of Policies
            </h2>
          </div>

          <div class="space-y-4 text-sm leading-7 text-white/58 sm:text-[15px] sm:leading-8">
            <p>
              By continuing to access or use this website, you acknowledge that
              you have read, understood, and agreed to be bound by these
              policies. If you do not agree with these policies, you must
              discontinue use of the website and refrain from placing an order.
            </p>

            <p>
              These policies are incorporated into all transactions with
              RGVPRIME LLC and apply to all website visitors,
              customers, account holders, purchasers, recipients, and any person
              or entity acting on their behalf.
            </p>
          </div>
        </div>
      </section>

      <div class="mt-8 space-y-7">
        {legalSections.map((section, index) => (
          <section
            id={section.id}
            class="scroll-mt-28 overflow-hidden rounded-[2.25rem] border border-white/10 bg-[#080808]/90 shadow-[0_28px_100px_rgba(0,0,0,0.32)]"
          >
            <div class="border-b border-white/10 bg-white/[0.025] p-6 sm:p-8">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="text-xs font-black uppercase tracking-[0.22em] text-red-400">
                    {section.eyebrow}
                  </p>

                  <h2 class="mt-3 text-2xl font-black tracking-tight text-white sm:text-3xl">
                    {section.title}
                  </h2>
                </div>

                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-red-500/20 bg-red-500/[0.08] text-xs font-black text-red-300">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>

              <p class="mt-5 max-w-4xl text-sm leading-7 text-white/58 sm:text-[15px] sm:leading-8">
                {section.intro}
              </p>
            </div>

            <div class="divide-y divide-white/10">
              {section.clauses.map((clause) => (
                <article class="grid gap-4 p-6 sm:p-8 lg:grid-cols-[0.33fr_1fr]">
                  <h3 class="text-sm font-black uppercase tracking-[0.14em] text-white/82">
                    {clause.title}
                  </h3>

                  <p class="text-sm leading-7 text-white/58 sm:text-[15px] sm:leading-8">
                    {clause.body}
                  </p>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <section class="mt-8 rounded-[2.25rem] border border-red-500/20 bg-red-500/[0.055] p-6 sm:p-8 lg:p-10">
        <p class="text-xs font-black uppercase tracking-[0.22em] text-red-300">
          Final Acknowledgment
        </p>

        <h2 class="mt-3 text-2xl font-black tracking-tight text-white">
          Continued Use Constitutes Agreement
        </h2>

        <p class="mt-5 max-w-5xl text-sm leading-7 text-white/62 sm:text-[15px] sm:leading-8">
          By remaining on this website, accessing product information, creating
          an account, communicating with RGVPRIME LLC, or placing an
          order, you acknowledge and agree that you understand the limitations,
          restrictions, disclaimers, and responsibilities described in these
          policies.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-red-600 px-5 text-xs font-black uppercase tracking-[0.1em] text-white transition hover:bg-red-500"
          >
            Contact Us
          </a>

          <a
            href="/track-order"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/15 bg-white/[0.04] px-5 text-xs font-black uppercase tracking-[0.1em] text-white transition hover:border-red-500/35 hover:bg-white/[0.08]"
          >
            Track Order
          </a>
        </div>
      </section>

      <p class="mt-8 text-center text-[11px] leading-6 text-white/28">
        This page is provided for business policy and website disclosure
        purposes. It does not constitute legal advice. RGVPRIME LLC
        may update these policies at any time.
      </p>
    </section>
  </main>

  <script is:inline>
    const backButton = document.querySelector("[data-back-button]");

    backButton?.addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back();
        return;
      }

      window.location.href = "/";
    });
  </script>
</BaseLayout>
