---
import "../styles/global.css";

import Agegate from "../components/agegate/AgeGate";
import GlobalPreloader from "../components/preloader/GlobalPreloader.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  canonical?: string;
}

const siteName = "RGVPRIME LLC";
const brandName = "RGVPRIME LLC";
const siteUrl = "https://rgvprimellc.com";

// Configure this public variable in Coolify/Vercel and rebuild the site.
// It is the public Omnisend Brand ID, never a private API key.
const omnisendBrandId = String(
  import.meta.env.PUBLIC_OMNISEND_BRAND_ID || "",
).trim();

const {
  title = "RGVPRIME LLC | Laboratory Research Products",
  description = "RGVPRIME LLC provides high-quality laboratory research products, transparent COA access, secure ordering and reliable service. Products are intended strictly for research use.",
  image = "/logo.webp",
  imageAlt = "RGVPRIME LLC laboratory research products",
  noindex = false,
  canonical,
} = Astro.props;

const currentPath = Astro.url.pathname;

const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).toString()
  : new URL(currentPath, siteUrl).toString();

const ogImageUrl = new URL(image, siteUrl).toString();
const logoUrl = new URL("/logo.webp", siteUrl).toString();

const fullTitle = title.includes(siteName)
  ? title
  : `${title} | ${siteName}`;

const imageExtension = image.split(".").pop()?.toLowerCase();

const ogImageType =
  imageExtension === "png"
    ? "image/png"
    : imageExtension === "webp"
      ? "image/webp"
      : "image/jpeg";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: brandName,
  legalName: brandName,
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    "@id": `${siteUrl}/#logo`,
    url: logoUrl,
    contentUrl: logoUrl,
    caption: brandName,
  },
  image: ogImageUrl,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  name: brandName,
  alternateName: "RGVPRIME",
  url: siteUrl,
  inLanguage: "en-US",
  publisher: {
    "@id": `${siteUrl}/#organization`,
  },
};

const webpageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: fullTitle,
  description,
  inLanguage: "en-US",
  isPartOf: {
    "@id": `${siteUrl}/#website`,
  },
  about: {
    "@id": `${siteUrl}/#organization`,
  },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: ogImageUrl,
  },
};
---

<!doctype html>
<html lang="en-US" data-theme="dark">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content={brandName} />
    <meta name="apple-mobile-web-app-title" content="RGVPRIME" />
    <meta name="author" content={brandName} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{fullTitle}</title>

    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="en-US" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    {
      noindex ? (
        <>
          <meta
            name="robots"
            content="noindex, nofollow, noarchive"
          />

          <meta
            name="googlebot"
            content="noindex, nofollow, noarchive"
          />
        </>
      ) : (
        <>
          <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
          />

          <meta
            name="googlebot"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
          />
        </>
      )
    }

    <link
      rel="icon"
      type="image/webp"
      href="/logo.webp"
      sizes="any"
    />

    <link
      rel="shortcut icon"
      type="image/webp"
      href="/logo.webp"
    />

    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      sizes="180x180"
    />

    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <script is:inline>
      (() => {
        const lightThemeEnabled = false;
        const storageKey = "rgv-color-theme";

        if (!lightThemeEnabled) {
          document.documentElement.dataset.theme = "dark";
          return;
        }

        try {
          const savedTheme = window.localStorage.getItem(storageKey);

          if (savedTheme === "light") {
            document.documentElement.dataset.theme = "light";
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute("content", "#ffffff");
          }
        } catch {
          // The dark design remains the default when storage is unavailable.
        }
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/logo.webp"
      fetchpriority="high"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(webpageSchema)}
    />

    <script is:inline define:vars={{ omnisendBrandId }}>
      window.__RGV_OMNISEND_ENABLED__ = Boolean(omnisendBrandId);

      if (omnisendBrandId) {
        window.omnisend = window.omnisend || [];

        window.omnisend.push(["brandID", omnisendBrandId]);
        window.omnisend.push(["track", "$pageViewed"]);

        if (
          !document.querySelector(
            'script[src="https://omnisnippet1.com/inshop/launcher-v2.js"]',
          )
        ) {
          var omnisendScript = document.createElement("script");

          omnisendScript.type = "text/javascript";
          omnisendScript.async = true;
          omnisendScript.src =
            "https://omnisnippet1.com/inshop/launcher-v2.js";

          omnisendScript.setAttribute(
            "data-rgv-omnisend",
            "true",
          );

          document.head.appendChild(omnisendScript);
        }
      }
    </script>

    <slot name="head" />
  </head>

  <body>
    <GlobalPreloader logoSrc="/logo.webp" />

    <div class="site-shell">
      <Agegate client:load />

      <slot />
    </div>

    <button
      id="rgv-theme-toggle"
      class="rgv-theme-toggle"
      type="button"
      hidden
      aria-label="Activate light mode"
      aria-pressed="false"
      title="Activate light mode"
    >
      <span class="rgv-theme-toggle__icon" aria-hidden="true">
        <svg class="rgv-theme-toggle__sun" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="rgv-theme-toggle__moon" viewBox="0 0 24 24" fill="none">
          <path d="M20.5 14.2A8.4 8.4 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" />
        </svg>
      </span>
      <span class="rgv-theme-toggle__label">Light</span>
    </button>

    <script is:inline>
      (() => {
        const storageKey = "rgv-color-theme";
        const root = document.documentElement;
        const toggle = document.getElementById("rgv-theme-toggle");
        const label = toggle?.querySelector(".rgv-theme-toggle__label");
        const themeColor = document.querySelector('meta[name="theme-color"]');

        if (!toggle || !label || toggle.hidden) return;

        const applyTheme = (theme, persist = false) => {
          const isLight = theme === "light";
          root.dataset.theme = isLight ? "light" : "dark";
          toggle.setAttribute("aria-pressed", String(isLight));
          toggle.setAttribute(
            "aria-label",
            isLight ? "Activate dark mode" : "Activate light mode",
          );
          toggle.title = isLight ? "Activate dark mode" : "Activate light mode";
          label.textContent = isLight ? "Dark" : "Light";

          if (themeColor) {
            themeColor.setAttribute("content", isLight ? "#ffffff" : "#050505");
          }

          if (persist) {
            try {
              window.localStorage.setItem(storageKey, isLight ? "light" : "dark");
            } catch {
              // Theme still works for this visit when storage is unavailable.
            }
          }
        };

        applyTheme(root.dataset.theme);

        toggle.addEventListener("click", () => {
          applyTheme(root.dataset.theme === "light" ? "dark" : "light", true);
        });

        window.addEventListener("storage", (event) => {
          if (event.key === storageKey) {
            applyTheme(event.newValue === "light" ? "light" : "dark");
          }
        });
      })();
    </script>
  </body>
</html>
