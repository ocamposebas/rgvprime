# WordPress base URL used for WooCommerce and the RGV COA Library REST API.
# Example: https://store.example.com (without a trailing slash)
PUBLIC_WP_URL=

# Private WooCommerce REST API credentials used by the Node server to create
# guest pending orders for card and wallet handoff. Grant read/write access and
# never expose either credential with a PUBLIC_ prefix.
WC_API_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Optional dedicated secret for approved 21+/RUO/Terms sessions. Configure the
# identical value as RGV_COMPLIANCE_SIGNING_SECRET in WordPress. When omitted,
# both applications use the existing PORTAL_API_SECRET/RGV_PORTAL_API_SECRET.
# Never expose this with a PUBLIC_ prefix.
COMPLIANCE_SIGNING_SECRET=

# Public Omnisend store identifier used by the official browser tracking snippet.
# This value is not a secret. Find it in Omnisend under Store settings -> API.
PUBLIC_OMNISEND_BRAND_ID=

# Private Omnisend API key used only by server endpoints to create contacts and
# apply the welcome-offer tags. Never expose this with a PUBLIC_ prefix.
OMNISEND_API_KEY=

# Optional comma-separated origins accepted by protected form endpoints during
# local previews or additional storefront domains.
# Example: http://localhost:4321,https://www.example.com
ALLOWED_ORIGINS=

# Optional: enables live USPS shipment status and delivery confirmation.
# Create production API credentials in the USPS Developer Portal.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# Put the public storefront into maintenance mode. Accepted enabled values:
# true, 1, yes, or on. Restart/redeploy the Node service after changing it.
MAINTENANCE_MODE=false

# Private server-side word used to preview the site during maintenance.
# Visit /?maintenance_access=YOUR_WORD once to authorize the current browser
# session. Never prefix this variable with PUBLIC_.
MAINTENANCE_BYPASS_TOKEN=

# Duration shown to visitors and sent in the HTTP Retry-After header.
MAINTENANCE_DURATION_HOURS=2
