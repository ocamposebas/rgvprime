# WordPress base URL used for WooCommerce and the RGV COA Library REST API.
# Example: https://store.example.com (without a trailing slash)
PUBLIC_WP_URL=

# Public Omnisend store identifier used by the official browser tracking snippet.
# This value is not a secret. Find it in Omnisend under Store settings -> API.
PUBLIC_OMNISEND_BRAND_ID=

# Optional: enables live USPS shipment status and delivery confirmation.
# Create production API credentials in the USPS Developer Portal.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# Put the public storefront into maintenance mode. Accepted enabled values:
# true, 1, yes, or on. Restart/redeploy the Node service after changing it.
MAINTENANCE_MODE=false

# Private server-side word used to preview the site during maintenance.
# Visit /?maintenance_access=YOUR_WORD once to authorize the current browser
# session. Never prefix this variable with PUBLIC_.
MAINTENANCE_BYPASS_TOKEN=

# Duration shown to visitors and sent in the HTTP Retry-After header.
MAINTENANCE_DURATION_HOURS=2
